<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+).

   routing_policy.json is DERIVED SESSION STATE (a cross-process snapshot the main
   process rewrites at every connection start). It is excluded from cloud backup and
   device transfer because restoring a stale snapshot could make the :openvpn
   process apply an outdated policy if it races a fresh session. Settings live in
   SharedPreferences and remain backed up.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="routing_policy.json" />
        <exclude domain="file" path="routing_policy.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="routing_policy.json" />
        <exclude domain="file" path="routing_policy.json.tmp" />
    </device-transfer>
</data-extraction-rules>
